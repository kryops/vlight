{
  "name": "@kryops/vlight",
  "version": "0.0.1",
  "main": "backend/dist/index.js",
  "repository": "https://github.com/kryops/vlight",
  "author": "Michael Manzinger <michael@kryops.de>",
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "backend",
      "frontend",
      "shared/*"
    ]
  },
  "scripts": {
    "all": "yarn lint && yarn test && yarn build",
    "clean": "yarn workspaces foreach -A run clean && rimraf node_modules/.cache .linaria-cache tsconfig.tsbuildinfo",
    "backend": "yarn workspace @vlight/backend",
    "build": "yarn run clean && run-p 'backend build' 'frontend build'",
    "client:tcp": "vpx backend/clients/vlight-tcp.ts",
    "client:udp": "vpx backend/clients/vlight-udp.ts",
    "doc": "yarn workspace @vlight/types doc",
    "docker:build": "docker build -t kryops/vlight .",
    "docker:run": "docker run --rm --privileged -p 8000:8000 -v $(pwd)/config:/usr/src/app/config -it --init kryops/vlight",
    "docker": "run-s docker:build docker:run",
    "frontend": "yarn workspace @vlight/frontend",
    "lint": "run-p --continue-on-error lint:oxlint lint:ts lint:format 'frontend lint:css'",
    "lint:oxlint": "vp lint",
    "lint:ts": "tsc -b frontend backend",
    "lint:ts:watch": "tsc -b frontend backend --watch",
    "lint:format": "vp fmt --check",
    "prepare": "vp config && rimraf node_modules/.cache .linaria-cache && yarn build",
    "format": "vp fmt",
    "prod": "run-s build start",
    "dev": "run-p 'backend dev' 'frontend dev' 'backend build --watch --preserveWatchOutput' 'frontend tsc:watch'",
    "start": "cross-env NODE_ENV=production && node .",
    "test": "vp test run"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "cross-env": "^10.1.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "type-fest": "^5.7.0",
    "typedoc": "^0.28.19",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "yarn@4.18.1",
  "resolutions": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000"
  }
}
